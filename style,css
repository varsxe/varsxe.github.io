body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  background: linear-gradient(120deg, #111, #222);
  color: #fff;
}

header, section {
  margin: 20px;
  padding: 20px;
  border-radius: 16px;
}

.glass {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.3);
}

nav a {
  margin-right: 15px;
  color: #fff;
  text-decoration: none;
}

iframe {
  width: 100%;
  height: 320px;
  border-radius: 12px;
}

.buy {
  display: inline-block;
  padding: 10px 18px;
  background: #fff;
  color: #000;
  text-decoration: none;
  border-radius: 10px;
  margin-top: 10px;
}

footer {
  text-align: center;
  opacity: 0.6;
  margin: 40px 0;
}
